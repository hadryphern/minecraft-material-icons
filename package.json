{
  "name": "minecraft-material-icons",
  "displayName": "Minecraft Material Icons",
  "description": "Tema de ícones que combina ícones pixel-art inspirados em Minecraft para pastas e arquivos de mods (Fabric, Forge, NeoForge, Quilt) com os ícones gerais do Material Icon Theme.",
  "version": "1.0.0",
  "publisher": "hadrykkxd",
  "author": {
    "name": "hadryphern",
    "url": "https://github.com/hadryphern"
  },
  "license": "MIT",
  "icon": "images/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/hadryphern/minecraft-material-icons.git"
  },
  "bugs": {
    "url": "https://github.com/hadryphern/minecraft-material-icons/issues"
  },
  "homepage": "https://github.com/hadryphern/minecraft-material-icons#readme",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Themes"
  ],
  "keywords": [
    "icons",
    "icon theme",
    "minecraft",
    "fabric",
    "forge",
    "neoforge",
    "quilt",
    "mod",
    "material"
  ],
  "galleryBanner": {
    "color": "#2b2b33",
    "theme": "dark"
  },
  "contributes": {
    "iconThemes": [
      {
        "id": "minecraft-material-icons",
        "label": "Minecraft Material Icons",
        "path": "./themes/minecraft-material-icons.json"
      }
    ]
  },
  "scripts": {
    "icons": "node scripts/generate-icons.mjs",
    "theme": "node scripts/build-theme.mjs",
    "validate": "node scripts/validate.mjs",
    "build": "npm run icons && npm run theme && npm run validate",
    "package": "npm run build && vsce package --no-dependencies --out dist/ && node scripts/verify-vsix.mjs",
    "add-folder": "node scripts/add-folder.mjs",
    "scan": "node scripts/scan-project.mjs",
    "preview": "node scripts/preview.mjs",
    "verify": "node scripts/verify-vsix.mjs"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@vscode/vsce": "^3.2.0",
    "fast-xml-parser": "^4.5.0",
    "material-icon-theme": "5.40.0",
    "yauzl": "^2.10.0"
  }
}
